root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[Cargo.lock]
indent_size = unset

[pnpm-lock.yaml]
indent_size = unset

[*.md]
indent_style = unset
indent_size = unset

[LICENSE]
indent_style = unset
indent_size = unset
